# Secrets and credentials — never enter image layers
.env
.env.*
*.pem
*.key
# Cookie jars and HTTP archives carry live session credentials
cookies.txt
*.cookie
cookies/
*.har

# User data and databases
data/
*.db
*.sqlite*
*.sqlite3
# SQLite sidecars: `*.db` does NOT match `app.db-wal`, and a WAL file carries
# committed rows that have not yet been checkpointed into the main database.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm

# Git metadata
.git
.gitignore
.gitattributes

# Python caches and virtual environments
# NOTE: the previous `venv/` pattern does NOT match `.venv311/`. Dotted venvs are
# matched explicitly, because leaving one in the context ships an entire local
# site-packages tree (234 MB here) into the image.
.venv/
.venv*/
venv/
venv*/
env/
ENV/
virtualenv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pip-wheel-metadata/

# Local tooling and editor state
.vscode/
.idea/
.claude/
.clineignore
.clinerules
.DS_Store

# Docs, tests, and compose files (runtime image needs none of these)
docs/
tests/
README.md
LICENSE
docker-compose.yml
docker-compose.yml.template
Dockerfile
.dockerignore

# Capture, audit and design artifacts — never needed at runtime, and excluded for
# size as much as hygiene: these hold screenshots, provider-contract captures and
# generated PDFs, some captured from live traffic.
artifacts/
output/
design/
tmp/
backups/

# Downloads and scratch files
downloads/
*.log
